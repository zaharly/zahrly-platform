{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArchiveBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::zahrly-community-storage"
    },
    {
      "Sid": "ArchiveObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::zahrly-community-storage/zahrly/archive/*"
    },
    {
      "Sid": "PredictionModelArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::zahrly-community-storage/zahrly/models/prediction_engine/*"
    }
  ]
}
